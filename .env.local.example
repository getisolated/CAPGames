# Copier en .env.local pour le développement local (pnpm dev).
# En production, ces valeurs sont fournies par deploy/.env (conteneur app).

# URL publique de l'API Supabase (cloud ou auto-hébergée derrière Caddy)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nécessaire uniquement si AUTH_BYPASS_OTP=true
SUPABASE_SERVICE_ROLE_KEY=

# Domaines d'e-mail autorisés, séparés par des virgules, sans @. "*" = tous.
ALLOWED_EMAIL_DOMAINS=capvision.fr

# true = connexion sans code OTP (DEV UNIQUEMENT)
AUTH_BYPASS_OTP=false
