############################################################################
# CAP Games — variables de la stack Docker (deploy/.env)
#
# Générer les secrets : sh deploy/scripts/gen-env.sh   (crée deploy/.env)
# NE JAMAIS committer deploy/.env
############################################################################

############
# Domaines
############
# Site Caddy de l'app. Prod : capgames.fr  | Local : http://localhost:8080
APP_SITE=capgames.fr
# Site Caddy de l'API Supabase. Prod : api.capgames.fr | Local : http://localhost:8000
API_SITE=api.capgames.fr
# Nom d'hôte nu de l'API (résolu vers l'hôte Docker depuis le conteneur app)
API_HOST=api.capgames.fr
# URL publique de l'app (Site URL GoTrue + origine CORS)
SITE_URL=https://capgames.fr
ADDITIONAL_REDIRECT_URLS=https://capgames.fr/**
# URL publique de l'API (utilisée par le navigateur ET le serveur Next.js)
SUPABASE_PUBLIC_URL=https://api.capgames.fr
API_EXTERNAL_URL=https://api.capgames.fr/auth/v1

############
# Application
############
# Image construite par GitHub Actions
APP_IMAGE=ghcr.io/getisolated/capgames:latest
ALLOWED_EMAIL_DOMAINS=capvision.fr
AUTH_BYPASS_OTP=false

############
# Secrets (remplis par gen-env.sh)
############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=

############
# Postgres
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

############
# E-mails OTP — Resend (https://resend.com/docs/send-with-smtp)
############
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Clé API Resend (re_xxxxxxxx)
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@capgames.fr
SMTP_SENDER_NAME=CAP Games
MAILER_SUBJECT_OTP=Ton code CAP Games

############
# Limites de débit GoTrue (IP partagée par tous les téléphones de la soirée)
############
RATE_LIMIT_EMAIL_SENT=300
RATE_LIMIT_OTP=1000
RATE_LIMIT_VERIFY=2000
RATE_LIMIT_TOKEN_REFRESH=5000

############
# Storage
############
# Taille max d'un fichier uploadé (octets). 50 Mo par défaut.
STORAGE_FILE_SIZE_LIMIT=52428800
